#!/bin/sh
set -eu

operation=${1:-integrated}
if [ "$operation" = integrated ]; then
  exec make test-current
fi

case "$operation" in
  candidate/hi-governance-decision-dossier/conformance) test_name=TestV4ConformanceGovernanceDecisionDossier ;;
  candidate/hi-requirement-identity-and-binding/conformance) test_name=TestV4ConformanceRequirementIdentityAndBinding ;;
  candidate/hi-operational-identity-allocation/conformance) test_name=TestV4ConformanceOperationalIdentityAllocation ;;
  candidate/hi-advisory-evidence-staging/conformance) test_name=TestV4ConformanceAdvisoryEvidenceStaging ;;
  candidate/hi-advisory-result-intake-and-recovery/conformance) test_name=TestV4ConformanceAdvisoryResultIntakeAndRecovery ;;
  candidate/hi-surface-skew-conformance/conformance) test_name=TestV4ConformanceSurfaceSkew ;;
  candidate/hi-provider-advisory-transport/conformance) test_name=TestV4ConformanceProviderAdvisoryTransport ;;
  candidate/hi-provider-routing-policy/conformance) test_name=TestV4ConformanceProviderRoutingPolicy ;;
  candidate/hi-review-principal-provenance/conformance) test_name=TestV4ConformanceReviewPrincipalProvenance ;;
  candidate/hi-ontology-and-surface-contract/conformance) test_name=TestV4ConformanceOntologyAndSurfaceContract ;;
  candidate/hi-source-bound-goal-establishment/conformance) test_name=TestV4ConformanceSourceBoundGoalEstablishment ;;
  candidate/hi-governed-planning-orchestration/conformance) test_name=TestV4ConformanceGovernedPlanningOrchestration ;;
  candidate/hi-model-assisted-interpretation-and-ambiguity/conformance) test_name=TestV4ConformanceModelAssistedInterpretationAndAmbiguity ;;
  candidate/hi-requirement-evolution-classification-and-successor/conformance) test_name=TestV4ConformanceRequirementEvolutionClassificationAndSuccessor ;;
  candidate/hi-evolution-execution-boundary/conformance) test_name=TestV4ConformanceEvolutionExecutionBoundary ;;
  candidate/hi-human-lifecycle-flow/conformance) test_name=TestV4ConformanceHumanLifecycleFlow ;;
  candidate/hi-status-and-control-projection/conformance) test_name=TestV4ConformanceStatusAndControlProjection ;;
  candidate/hi-installed-human-surface-packaging/conformance) test_name=TestV4ConformanceInstalledHumanSurfacePackaging ;;
  candidate/hi-dogfood-acceptance/conformance) test_name=TestV4ConformanceDogfoodAcceptance ;;
  *) echo "unknown validation operation: $operation" >&2; exit 64 ;;
esac

result=$(mktemp "${TMPDIR:-/tmp}/praxis-validation.XXXXXX")
trap 'rm -f "$result"' EXIT HUP INT TERM
go test -json -timeout=10m ./... -run "^${test_name}$" >"$result"
if ! awk -v name="$test_name" '$1 ~ /"Action":"pass"/ && $0 ~ ("\"Test\":\"" name "\"") { found=1 } END { exit(found ? 0 : 1) }' "$result"; then
  echo "required conformance test did not run and pass: $test_name" >&2
  exit 1
fi
printf 'PRAXIS-VALIDATION %s\n' "$operation"
