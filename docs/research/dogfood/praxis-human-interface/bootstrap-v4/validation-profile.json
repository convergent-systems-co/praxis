{
  "id": "praxis-human-interface/v4-validation-profile",
  "version": "1",
  "kernel_version": "praxis-human-interface-bootstrap-v4/1",
  "entrypoint": ".praxis/validate",
  "integrated_operation": "integrated",
  "integrated_argv": ["make", "test-current"],
  "candidate_operation_pattern": "candidate/<accepted-candidate-short-id>/conformance",
  "candidate_operations": [
    "candidate/hi-governance-decision-dossier/conformance",
    "candidate/hi-requirement-identity-and-binding/conformance",
    "candidate/hi-operational-identity-allocation/conformance",
    "candidate/hi-advisory-evidence-staging/conformance",
    "candidate/hi-advisory-result-intake-and-recovery/conformance",
    "candidate/hi-surface-skew-conformance/conformance",
    "candidate/hi-provider-advisory-transport/conformance",
    "candidate/hi-provider-routing-policy/conformance",
    "candidate/hi-review-principal-provenance/conformance",
    "candidate/hi-ontology-and-surface-contract/conformance",
    "candidate/hi-source-bound-goal-establishment/conformance",
    "candidate/hi-governed-planning-orchestration/conformance",
    "candidate/hi-model-assisted-interpretation-and-ambiguity/conformance",
    "candidate/hi-requirement-evolution-classification-and-successor/conformance",
    "candidate/hi-evolution-execution-boundary/conformance",
    "candidate/hi-human-lifecycle-flow/conformance",
    "candidate/hi-status-and-control-projection/conformance",
    "candidate/hi-installed-human-surface-packaging/conformance",
    "candidate/hi-dogfood-acceptance/conformance"
  ],
  "timeout": "10m",
  "maximum_output_bytes": 1048576,
  "unknown_operation": "fail",
  "missing_or_drifted_entrypoint": "fail",
  "malformed_or_unhandled_evidence": "fail",
  "required_acknowledgement": "PRAXIS-VALIDATION <exact-operation-id>",
  "proof_states": [
    "attempted",
    "checkpoint_completed",
    "mechanism_tests_passed",
    "candidate_conformance_qualified",
    "product_outcome_supported_by_evidence",
    "goal_settled"
  ]
}
