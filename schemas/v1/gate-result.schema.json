{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.praxis.dev/v1/gate-result.schema.json",
  "title": "Gate Result",
  "description": "The outcome of evaluating a graph node's evidence requirement against the proof records collected for it.",
  "type": "object",
  "required": ["spec_version", "node_id", "satisfied", "reasons", "evaluated"],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "node_id": {
      "type": "string"
    },
    "satisfied": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
