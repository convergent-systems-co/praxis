{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.praxis.dev/v1/resource-claim.schema.json",
  "title": "ResourceClaim",
  "description": "A set of abstract resource claims a graph node holds or requests, without naming a specific vendor or hardware model.",
  "type": "object",
  "required": ["spec_version", "claims"],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource_type", "quantity"],
        "properties": {
          "resource_type": {
            "type": "string",
            "description": "Abstract resource category, e.g. 'compute-slot' or 'memory' — illustrative only, not a fixed enum. Must never name a specific vendor or hardware model."
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
